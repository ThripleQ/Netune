{
  "version": "1.0",

  /* ── Audio ───────────────────────────────────────────
     backend:  "auto" | "alsa" | "pulseaudio" | "sdl"
     sample_rate, channels, bits_per_sample: output format
     volume:   0–100
     device:   "default" or ALSA device name like "hw:0,0"
   ─────────────────────────────────────────────────── */
  "audio": {
    "backend": "auto",
    "sample_rate": 44100,
    "channels": 2,
    "bits_per_sample": 16,
    "buffer_frames": 4096,
    "volume": 80,
    "device": "default"
  },

  /* ── Playback ────────────────────────────────────────
     loop_mode:  0=no loop, 1=single track, 2=list
     gapless:    smooth transition between tracks
     crossfade_sec: crossfade duration (0=off)
     seek_step_sec: how many seconds per arrow key press
   ─────────────────────────────────────────────────── */
  "playback": {
    "loop_mode": 0,
    "gapless": true,
    "crossfade_sec": 0,
    "resume_on_startup": false,
    "seek_step_sec": 5
  },

  /* ── UI ─────────────────────────────────────────────
     theme:  "default" | "catppuccin" | "dracula"
             | "netease_dark" | "netease_light"
     layout: path to a custom layout YAML
     keybindings: "default" or path to keybindings YAML
   ─────────────────────────────────────────────────── */
  "ui": {
    "theme": "default",
    "layout": "data/layouts/default.yaml",
    "keybindings": "default",
    "show_lyric": true,
    "show_cover": false,
    "show_status_bar": true
  },

  /* ── Music Sources ───────────────────────────────────
     local: scan local music directories.
       dirs: list of paths (supports ~, $HOME, $VAR).
             Empty array = nothing scanned.
       Example:
         "dirs": ["~/Music", "~/Downloads/tracks"]
   ─────────────────────────────────────────────────── */
  "music_sources": {
    "local": {
      "enabled": true,
      "dirs": ["~/Music/pop", "~/Music/rock", "~/Music/jazz"],
      "recursive": true,
      "show_hidden": false
    },
    /* Netease Cloud Music integration.
       Needs a cookie_file for private playlists. */
    "netease": {
      "enabled": true,
      "quality": "standard",
      "cookie_file": "",
      "auto_login": false
    }
  },

  /* ── Network ─────────────────────────────────────────
     proxy:  "" = no proxy, or "http://127.0.0.1:7890"
   ─────────────────────────────────────────────────── */
  "network": {
    "proxy": "",
    "timeout_sec": 10,
    "max_retries": 2,
    "user_agent": "Netune/2.0"
  },

  /* ── Plugins ─────────────────────────────────────────
     Preferred decoder/audio-output order.
     The first available one is used. */
  "plugins": {
    "decoders": {
      "preferred": ["dr_mp3", "dr_flac", "dr_wav"]
    },
    "audio_outputs": {
      "preferred": ["alsa", "pulseaudio", "sdl"]
    }
  }
}
