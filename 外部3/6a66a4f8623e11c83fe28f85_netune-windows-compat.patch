+#ifdef _MSC_VER
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <io.h>
+#include <direct.h>
+#include <wchar.h>
+#include <sys/stat.h>
+#include <sys/types.h>
